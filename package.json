{
  "name": "create-skeleton-next",
  "version": "1.1.1",
  "description": "CLI to scaffold Next.js projects from skeleton templates",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorggerojas/create-skeleton-next.git"
  },
  "homepage": "https://github.com/jorggerojas/create-skeleton-next#readme",
  "bugs": {
    "url": "https://github.com/jorggerojas/create-skeleton-next/issues"
  },
  "bin": {
    "create-skeleton-next": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint": "biome check --write .",
    "lint:ci": "biome ci",
    "format": "biome format --write"
  },
  "keywords": [
    "next.js",
    "nextjs",
    "scaffold",
    "template",
    "cli",
    "create-next-app"
  ],
  "author": "jorggerojas",
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "execa": "10.0.1",
    "picocolors": "1.1.1",
    "prompts": "2.4.2",
    "semver": "7.8.5",
    "update-notifier": "7.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@codecov/vite-plugin": "2.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.2.0",
    "@types/prompts": "2.4.9",
    "@types/semver": "7.8.0",
    "@types/update-notifier": "6.0.8",
    "@vitest/coverage-istanbul": "4.1.11",
    "happy-dom": "20.11.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "standard-version": "9.5.0",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,css,mjs,cjs}": [
      "biome check --write --error-on-warnings --files-ignore-unknown=true"
    ]
  }
}
