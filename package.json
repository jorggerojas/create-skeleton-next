{
  "name": "create-skeleton-next",
  "version": "1.0.1",
  "description": "CLI to scaffold Next.js projects from skeleton templates",
  "type": "module",
  "bin": {
    "create-skeleton-next": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint": "biome check --write .",
    "lint:ci": "biome ci",
    "format": "biome format --write"
  },
  "keywords": [
    "next.js",
    "nextjs",
    "scaffold",
    "template",
    "cli",
    "create-next-app"
  ],
  "author": "jorggerojas",
  "license": "MIT",
  "dependencies": {
    "commander": "13.1.0",
    "execa": "9.5.2",
    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@codecov/vite-plugin": "1.9.1",
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "25.3.0",
    "@types/prompts": "2.4.9",
    "@vitest/coverage-istanbul": "4.0.18",
    "happy-dom": "20.7.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "standard-version": "9.5.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,css,mjs,cjs}": [
      "biome check --write --error-on-warnings --files-ignore-unknown=true"
    ]
  }
}
